#!/bin/bash
# postinstall-menu - runs after the menu-only tainer-menu.pkg payload lands.
#
# Starts the freshly installed menu-bar app once for the current GUI user.
# That first launch registers it as a login item (SMAppService), so it
# starts at every login after. Never fails the install.
set -uo pipefail

APP="/Applications/Tainer Menu.app"
OLD_AGENT=/Library/LaunchAgents/io.cyber5.tainer.menu.plist

CONSOLE_USER=$(stat -f%Su /dev/console 2>/dev/null || true)
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
    CONSOLE_UID=$(id -u "$CONSOLE_USER" 2>/dev/null || true)
    if [[ -n "$CONSOLE_UID" ]]; then
        # The pre-1.6.0 launchd agent, should preinstall not have run.
        launchctl bootout "gui/${CONSOLE_UID}/io.cyber5.tainer.menu" 2>/dev/null || true
        rm -f "$OLD_AGENT" 2>/dev/null || true
        if [[ -d "$APP" ]]; then
            launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" /usr/bin/open -g "$APP" 2>/dev/null || true
            echo "postinstall-menu: started Tainer Menu for $CONSOLE_USER"
        fi
    fi
fi

exit 0
