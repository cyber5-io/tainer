#!/bin/bash
# postinstall-only - runs after the tainer-only.pkg payload lands.
#
# Just creates /usr/local/bin/tainer → /opt/tainer/bin/tainer so the CLI
# is on PATH out of the box. No sudoers / pf changes — those belong to
# cyberstack.pkg (which the user must have already installed separately).
set -euo pipefail

# /usr/local/bin may not exist on a fresh-out-of-box Mac (it's user-owned
# and only created on demand). Make sure it's there before linking.
install -d -m 0755 -o root -g wheel /usr/local/bin
ln -sf /opt/tainer/bin/tainer /usr/local/bin/tainer

echo "postinstall: tainer CLI installed at /usr/local/bin/tainer"

# tainer SSH client config: system-wide drop-in so bare
# `ssh <pod>@ssh.tainer.me` resolves to the tainer key for every user
# (including those with no ~/.ssh/config). `~` expands per connecting user;
# the per-user Include is managed by `tainer start`.
install -d -m 0755 /etc/ssh/ssh_config.d
cat > /etc/ssh/ssh_config.d/0-tainer.conf <<'EOF'
Host ssh.tainer.me
  IdentityFile ~/.config/tainer/keys/tainer_rsa
  IdentitiesOnly yes
  UpdateHostKeys no
EOF
chmod 0644 /etc/ssh/ssh_config.d/0-tainer.conf
echo "postinstall: tainer ssh_config.d drop-in installed"

exit 0
